# =====================================================================
#  Inova Painting Corp — Apache / LiteSpeed (Hostinger)
#  Production: https://inovapaintingpro.com
#  Test environment: inova.escolats.com.br (noindex applied below)
# =====================================================================

Options -Indexes -MultiViews
ServerSignature Off
AddDefaultCharset UTF-8
DirectoryIndex index.html
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# ---------------------------------------------------------------------
#  MIME types
# ---------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json  .webmanifest
  AddType image/webp                 .webp
  AddType image/svg+xml              .svg
  AddType image/x-icon               .ico
  AddType text/plain                 .txt
  AddType text/vcard                 .vcf
  AddCharset UTF-8 .html .css .js .txt .xml .webmanifest .vcf
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # -------------------------------------------------------------------
  #  Antispam / abuse: block vulnerability scanners and common probes
  # -------------------------------------------------------------------
  RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|masscan|zgrab|wpscan|acunetix|netsparker|nmap|httrack|jorgee|dirbuster) [NC]
  RewriteRule .* - [F,L]

  # Referrer spam
  RewriteCond %{HTTP_REFERER} (semalt|buttons-for-website|darodar|best-seo-offer|ilovevitaly|priceg|hulfingtonpost|social-buttons|free-share-buttons) [NC]
  RewriteRule .* - [F,L]

  # WordPress / PHP probes (this is a static site)
  RewriteRule ^(wp-admin|wp-includes|wp-content|wp-login\.php|xmlrpc\.php|phpmyadmin|\.env|config\.php|admin\.php) - [F,L,NC]

  # -------------------------------------------------------------------
  #  HTTPS + no www
  # -------------------------------------------------------------------
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # -------------------------------------------------------------------
  #  Private files: dotfiles (except /.well-known), docs, scripts, markdown
  # -------------------------------------------------------------------
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule ^(docs|scripts|node_modules)(/|$) - [F,L]
  RewriteRule \.(md|sh|ps1|log|bak|swp|ini|lock)$ - [F,L,NC]

  # -------------------------------------------------------------------
  #  Test environment: serve a robots.txt that blocks all crawling
  # -------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^inova\.escolats\.com\.br$ [NC]
  RewriteRule ^robots\.txt$ robots-staging.txt [L]

  # -------------------------------------------------------------------
  #  Contact card aliases (business card / QR / bio links)
  # -------------------------------------------------------------------
  RewriteRule ^(links|contact|bio|vcard)/?$ /card [R=301,L,NC]

  # -------------------------------------------------------------------
  #  Remove trailing slash from non-directory URLs:  /card/ -> /card
  # -------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # -------------------------------------------------------------------
  #  Clean URLs (no .html anywhere):  /index.html -> /   ·   /page.html -> /page   ·   /page -> page.html
  # -------------------------------------------------------------------
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ---------------------------------------------------------------------
#  Security headers
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

# Test environment: never index (removed automatically on the final domain)
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Host ^inova\.escolats\.com\.br$ IS_STAGING
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" env=IS_STAGING
</IfModule>

# ---------------------------------------------------------------------
#  Compression
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/manifest+json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml image/x-icon
</IfModule>

# ---------------------------------------------------------------------
#  Cache ("clean cache" strategy)
#  HTML is always revalidated, so every deploy shows up immediately.
#  CSS/JS are cached for a year and refreshed through ?v= (scripts/clean-cache).
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 month"
  ExpiresByType text/html                     "access plus 0 seconds"
  ExpiresByType text/css                      "access plus 1 year"
  ExpiresByType application/javascript        "access plus 1 year"
  ExpiresByType text/javascript               "access plus 1 year"
  ExpiresByType image/webp                    "access plus 6 months"
  ExpiresByType image/jpeg                    "access plus 6 months"
  ExpiresByType image/png                     "access plus 6 months"
  ExpiresByType image/svg+xml                 "access plus 6 months"
  ExpiresByType image/x-icon                  "access plus 1 month"
  ExpiresByType application/manifest+json     "access plus 1 week"
  ExpiresByType text/plain                    "access plus 1 day"
  ExpiresByType application/xml               "access plus 1 day"
  ExpiresByType text/xml                      "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.vcf$">
    Header set Content-Disposition "attachment; filename=Inova-Painting.vcf"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpe?g|png|svg)$">
    Header set Cache-Control "public, max-age=15552000"
  </FilesMatch>
</IfModule>
